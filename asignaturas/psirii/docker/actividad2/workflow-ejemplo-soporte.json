{
  "name": "Ejemplo: Gestión de incidencias web",
  "nodes": [
    {
      "parameters": {
        "content": "## 🚀 Flujo de Ejemplo: Gestión de Incidencias Web\n\nEste flujo demuestra una automatización real y limpia:\n1. **Webhook:** Recibe datos de un formulario web en formato JSON.\n2. **Edit Fields:** Valida campos, añade timestamp y calcula prioridad.\n3. **Baserow:** Registra la fila en la base de datos persistente.\n4. **Telegram:** Alerta instantáneamente al canal de soporte.",
        "height": 190,
        "width": 780,
        "color": 4
      },
      "id": "sticky-note-1",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        240,
        100
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incidencias-soporte",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {}
      },
      "id": "c1f7b0a1-1234-4567-89ab-cdef01234567",
      "name": "1. Webhook formulario (Trigger)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        260,
        340
      ],
      "webhookId": "formulario-soporte-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-nombre",
              "name": "nombre",
              "value": "={{ $json.body.nombre || 'Usuario anónimo' }}",
              "type": "string"
            },
            {
              "id": "field-email",
              "name": "email",
              "value": "={{ $json.body.email || 'sin-correo@ejemplo.com' }}",
              "type": "string"
            },
            {
              "id": "field-asunto",
              "name": "asunto",
              "value": "={{ $json.body.asunto || 'Consulta general' }}",
              "type": "string"
            },
            {
              "id": "field-mensaje",
              "name": "mensaje",
              "value": "={{ $json.body.mensaje || 'Sin detalles proporcionados' }}",
              "type": "string"
            },
            {
              "id": "field-timestamp",
              "name": "fecha_registro",
              "value": "={{ $now.format('yyyy-MM-dd HH:mm:ss') }}",
              "type": "string"
            },
            {
              "id": "field-prioridad",
              "name": "prioridad",
              "value": "={{ ($json.body.asunto && $json.body.asunto.toLowerCase().includes('urgente')) ? 'Alta' : 'Normal' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "d2e8c1b2-2345-5678-90ab-cdef12345678",
      "name": "2. Validar y formatear (Edit Fields)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
